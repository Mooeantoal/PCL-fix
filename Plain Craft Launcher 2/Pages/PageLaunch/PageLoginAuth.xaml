<Grid x:Class="PageLoginAuth" Tag="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PCL"
      mc:Ignorable="d" d:DesignWidth="317.6" Margin="0,0,0,-2">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="224" />
    </Grid.ColumnDefinitions>
    <local:MyCheckBox x:Name="CheckOAuth" Height="20" Margin="-1,0,0,8" Text="使用免密登录（Yggdrasil Connect）" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
    <local:MyComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" Height="28" x:Name="ComboName" />
    <TextBlock Text="邮箱" Grid.Row="1" VerticalAlignment="Center" x:Name="LabName" />
    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="TextPass" />
    <TextBlock Text="密码" Grid.Row="3" VerticalAlignment="Center" x:Name="LabPass" />
    <local:MyCheckBox x:Name="CheckRemember" Tag="LoginRemember" Height="20" Margin="-1,12,80,0" Text="记住密码" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" />
    <local:MyTextButton Margin="0,12,2,0" x:Name="BtnLink" Content="注册账号" Grid.Row="4" HorizontalAlignment="Right" Grid.Column="1" Padding="20,0,0,0" HorizontalContentAlignment="Right" FontSize="13" VerticalContentAlignment="Center" />
    <StackPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="1" x:Name="PanOAuth" Visibility="Collapsed" VerticalAlignment="Top">
        <local:MyButton x:Name="BtnOAuthLogin" Text="免密登录" Height="32" Margin="0,0,0,8" />
        <TextBlock x:Name="LabOAuthHint" TextWrapping="Wrap" FontSize="12" Foreground="#FF888888" Text="将在浏览器中打开皮肤站登录页面，无需输入密码。" />
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="1" x:Name="PanOAuthLoggedIn" Visibility="Collapsed" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="LabOAuthName" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
            <local:MyTextButton x:Name="BtnOAuthLogout" Content="退出登录" Margin="12,0,0,0" FontSize="12" VerticalContentAlignment="Center" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF888888" Text="已通过免密登录，点击启动游戏即可。" />
    </StackPanel>
</Grid>